top        = _{ SOI ~ sexpr ~ EOI }
sexpr      = _{ "(" ~ term? ~ ")" }
term       = _{ obj | array | value }
obj        = { ident? ~ field+ }
array      = { elem+ }
field      = { field_name ~ sexpr }
elem       = { ":" ~ sexpr }
field_name = @{ ":" ~ ident }
ident      = @{ quoted_str | (ASCII_ALPHANUMERIC | "-" | "_" | ".")+ }
char       = @{ !("(" | ")") ~ ANY }
value      = { quoted_str | simple_val }
simple_val = { char+ }
quoted_str = ${ "\"" ~ schar* ~ "\"" }
schar      = { !("\"") ~ ANY | "\\" ~ "\"" }
WHITESPACE = _{ " " | "\n" | "\r" | "\t" | "\x00" }
