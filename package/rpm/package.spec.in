Name:           snx-rs
Version:        {{version}}
Release:        1%{?dist}
Summary:        SNX-RS Check Point VPN Client for Linux

License:        AGPL-3.0-or-later
URL:            https://github.com/ancwrd1/snx-rs
BuildArch:      {{arch}}

Requires:       glibc >= {{glibc}}

%description
Unofficial Linux client for Check Point VPN, written in Rust.

%prep
# No prep needed, files are already in BUILDROOT

%build
# No build needed, binaries are pre-built

%install
cp -a $RPM_BUILDROOT/* %{buildroot}/

%files
/usr/bin/snx-rs
/usr/bin/snx-rs-gui
/usr/bin/snxctl
/usr/lib/systemd/system/snx-rs.service
/usr/share/applications/snx-rs-gui.desktop
/usr/share/icons/hicolor/symbolic/apps/snx-rs-*.svg

%pre
if [ "$1" = 2 ]; then
    systemctl stop snx-rs 2>/dev/null >/dev/null || true
fi
# Versions before 6.4.2 installed the unit into /etc/systemd/system. Once the unit lives in
# /usr/lib, a file in /etc is an admin override and must be left alone.
if [ -f /etc/systemd/system/snx-rs.service ] && [ ! -f /usr/lib/systemd/system/snx-rs.service ]; then
    systemctl stop snx-rs 2>/dev/null >/dev/null || true
    systemctl disable snx-rs 2>/dev/null >/dev/null || true
    rm -f /etc/systemd/system/snx-rs.service
    mkdir -p /var/lib/rpm-state/snx-rs
    touch /var/lib/rpm-state/snx-rs/migrate-unit
fi
exit 0

%post
systemctl daemon-reload 2>/dev/null >/dev/null || true
if [ -f /var/lib/rpm-state/snx-rs/migrate-unit ]; then
    rm -rf /var/lib/rpm-state/snx-rs
    systemctl enable --now snx-rs 2>/dev/null >/dev/null || true
elif [ "$1" = 1 ]; then
    systemctl enable --now snx-rs 2>/dev/null >/dev/null || true
else
    systemctl start snx-rs 2>/dev/null >/dev/null || true
fi
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
pkill -USR1 -x snx-rs-gui 2>/dev/null >/dev/null || true
exit 0

%preun
case "$1" in
    0)
        # Uninstall (not upgrade)
        systemctl disable --now snx-rs 2>/dev/null >/dev/null || true
        pkill -x snx-rs-gui 2>/dev/null >/dev/null || true
        ;;
    1)
        # Upgrade
        ;;
esac
exit 0

%postun
case "$1" in
    0)
        # Uninstall
        rm -rf /var/cache/snx-rs
        systemctl daemon-reload
        ;;
    1)
        # Upgrade
        ;;
esac
exit 0
