import { Button, CheckBox, LineEdit, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import { Tr } from "tr.slint";

export component PromptWindow inherits Window {
    title: Tr.auth-dialog-title;
    min-width: 500px;
    min-height: root.base-min-height;
    max-width: 500px;
    default-font-size: 14px;

    in property <string> header;
    in property <string> prompt;
    in property <string> default-entry;
    in property <bool> secure: false;
    in property <bool> show-user-name: false;
    in property <string> user-name-prompt;
    in-out property <string> user-name;
    in property <bool> show-save: false;
    in-out property <bool> save-checked: false;
    in property <bool> save-in-plain-text: false;

    callback ok-clicked(string, string, bool);
    callback cancel-clicked();
    callback fit-height();

    property <length> base-min-height: 220px;
    out property <length> preferred-content-height: max(root.base-min-height, root-layout.preferred-height);

    changed save-checked => { root.fit-height(); }

    changed default-entry => {
        if (!root.secure) { entry.select-all(); }
    }

    forward-focus: entry;

    init => {
        entry.focus();
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-clicked();
                return accept;
            }
            return reject;
        }

        root-layout := VerticalBox {
            padding: 14px;
            spacing: 12px;

            if root.header != "": Text {
                text: root.header;
                font-size: 13px;
                font-weight: 400;
                opacity: 0.75;
                horizontal-alignment: left;
                wrap: TextWrap.word-wrap;
            }

            Rectangle {
                background: Palette.alternate-background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    alignment: start;

                    if root.show-user-name: VerticalLayout {
                        spacing: 4px;
                        padding-bottom: 8px;

                        Text {
                            text: root.user-name-prompt;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-alignment: left;
                        }

                        user-name-entry := LineEdit {
                            text <=> root.user-name;
                            accepted => { entry.focus(); }
                            init => {
                                self.focus();
                                self.select-all();
                            }
                        }
                    }

                    Text {
                        text: root.prompt;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: left;
                    }

                    entry := LineEdit {
                        text: root.default-entry;
                        input-type: root.secure ? InputType.password : InputType.text;
                        accepted(text) => { root.ok-clicked(root.user-name, text, root.save-checked); }
                    }

                    if root.show-save: VerticalLayout {
                        padding-top: 8px;
                        spacing: 4px;

                        CheckBox {
                            text: Tr.auth-save-credentials;
                            checked <=> root.save-checked;
                        }

                        if root.save-checked && root.save-in-plain-text: Text {
                            text: Tr.auth-save-plain-text-warning;
                            color: #d97706;
                            font-size: 13px;
                            horizontal-alignment: left;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 6px;

                Button {
                    text: Tr.button-cancel;
                    min-width: 80px;
                    clicked => { root.cancel-clicked(); }
                }

                Button {
                    text: Tr.button-ok;
                    min-width: 80px;
                    primary: true;
                    clicked => { root.ok-clicked(root.user-name, entry.text, root.save-checked); }
                }
            }
        }
    }
}